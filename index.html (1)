<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>RAMP·SIGHT — 지상조업 장비 실시간 위치·상태 추적</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0B0F13;
  --bg-1:#10151B;
  --surface:#141B22;
  --surface-2:#1B242D;
  --line:#26313B;
  --line-soft:#1D2730;
  --ink:#EDEFF1;
  --ink-dim:#A9B4BC;
  --ink-mute:#6E7A83;
  --amber:#E8A33D;
  --amber-dim:#8A6526;
  --amber-wash:#241C0E;
  --copper:#D9764A;
  --ok:#4FAE85;
  --danger:#D9634A;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
:root:not([data-theme="light"]){color-scheme:dark;}
*,*::before,*::after{box-sizing:inherit;}
html{scroll-behavior:smooth;scroll-padding-top:calc(70px + env(safe-area-inset-top,0px));}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:"IBM Plex Sans KR",system-ui,-apple-system,"Apple SD Gothic Neo","Malgun Gothic",sans-serif;
  font-weight:400;line-height:1.65;-webkit-font-smoothing:antialiased;font-size:16px;
}
.mono{font-family:"IBM Plex Mono","IBM Plex Sans KR",monospace;}
img{max-width:100%;}
a{color:inherit;}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(20px,4vw,32px);}

nav{
  position:sticky;top:0;z-index:50;background:rgba(11,15,19,.86);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--line-soft);
  padding-top:env(safe-area-inset-top,0px);
}
.nav-in{display:flex;align-items:center;gap:28px;height:64px;}
.logo{display:flex;align-items:center;gap:9px;font-weight:600;letter-spacing:-.01em;font-size:16.5px;text-decoration:none;}
.logo-mark{width:20px;height:20px;display:grid;grid-template:1fr 1fr/1fr 1fr;gap:2.5px;flex:none;}
.logo-mark i{background:var(--ink-dim);border-radius:1px;}
.logo-mark i:nth-child(2),.logo-mark i:nth-child(3){background:var(--amber);}
.nav-links{margin-left:auto;display:flex;gap:26px;align-items:center;}
.nav-links a{text-decoration:none;color:var(--ink-dim);font-size:14px;font-weight:500;transition:color .15s;}
.nav-links a:hover{color:var(--ink);}
.btn{
  display:inline-flex;align-items:center;gap:8px;border:none;cursor:pointer;text-decoration:none;
  font-family:inherit;font-size:14.5px;font-weight:600;padding:11px 20px;border-radius:3px;
  background:var(--amber);color:#241A08;transition:background .15s,transform .1s;
}
.btn:hover{background:#F2B558;}
.btn:active{transform:scale(.98);}
.btn-line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1px var(--line);}
.btn-line:hover{box-shadow:inset 0 0 0 1px var(--ink-mute);background:var(--surface);}
.btn-sm{padding:8px 15px;font-size:13.5px;}
a:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid var(--amber);outline-offset:2px;}

.hero{padding:clamp(56px,9vw,104px) 0 60px;position:relative;text-align:center;}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--amber);
  margin:0 0 24px;padding:6px 12px 6px 10px;border:1px solid var(--amber-dim);border-radius:2px;background:var(--amber-wash);
}
.eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--amber);}
h1{
  font-size:clamp(32px,5.2vw,58px);line-height:1.14;font-weight:700;
  letter-spacing:-.025em;margin:0 auto 24px;max-width:15.5ch;color:var(--ink);
}
h1 em{font-style:normal;color:var(--amber);}
.hero p.lead{font-size:clamp(15.5px,1.5vw,18px);color:var(--ink-dim);max-width:52ch;margin:0 auto 32px;line-height:1.75;}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;}
.hero-note{margin-top:18px;font-size:13px;color:var(--ink-mute);display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:center;}
.hero-note .sep{color:var(--line);}

.stripe{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);margin-top:56px;text-align:left;}
.stripe div{padding:20px clamp(14px,2vw,24px);border-left:1px solid var(--line-soft);}
.stripe div:first-child{border-left:none;}
.stripe .v{font-size:clamp(20px,2.4vw,28px);font-weight:600;letter-spacing:-.02em;color:var(--ink);font-variant-numeric:tabular-nums;}
.stripe .l{font-size:12.5px;color:var(--ink-mute);margin-top:4px;}

.apron{margin-top:44px;background:var(--surface);border:1px solid var(--line);border-radius:4px;overflow:hidden;text-align:left;}
.apron-bar{display:flex;align-items:center;gap:10px;padding:12px 18px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--ink-mute);}
.apron-bar b{color:var(--ink-dim);font-weight:500;}
.dot-live{width:6px;height:6px;border-radius:50%;background:var(--ok);flex:none;position:relative;}
.dot-live::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:1px solid var(--ok);opacity:.5;animation:ping 2.2s ease-out infinite;}
@keyframes ping{0%{transform:scale(.6);opacity:.6;}100%{transform:scale(2.4);opacity:0;}}
.apron-bar .right{margin-left:auto;font-variant-numeric:tabular-nums;}
.apron svg{display:block;width:100%;height:auto;}
.apron-legend{display:flex;gap:18px;flex-wrap:wrap;padding:12px 18px;border-top:1px solid var(--line);font-size:12px;color:var(--ink-mute);}
.apron-legend span{display:inline-flex;align-items:center;gap:6px;}
.apron-legend i{width:7px;height:7px;border-radius:50%;display:inline-block;}

.unit-panel{margin-top:16px;background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:22px clamp(18px,3vw,26px);text-align:left;}
.unit-head{display:flex;align-items:center;gap:10px;margin-bottom:16px;}
.unit-id{display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:600;color:var(--ink);}
.unit-type{font-weight:400;color:var(--ink-mute);font-size:12.5px;}
.unit-badge{margin-left:auto;font-size:11.5px;padding:3px 9px;border-radius:2px;background:var(--amber-wash);color:var(--amber);}
.unit-badge.ok{background:rgba(79,174,133,.14);color:var(--ok);}
.unit-route{width:100%;height:auto;display:block;margin-bottom:16px;}
.unit-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
.unit-stats > div{display:flex;flex-direction:column;gap:5px;}
.unit-stats .l{font-size:11.5px;color:var(--ink-mute);}
.unit-stats .v{font-size:14.5px;color:var(--ink);font-weight:500;}
.unit-divider{height:1px;background:var(--line-soft);margin:20px 0;}
.task-row{display:flex;justify-content:space-between;gap:12px;font-size:13.5px;color:var(--ink-dim);margin-bottom:9px;flex-wrap:wrap;}
.task-row .v{color:var(--amber);font-weight:600;}
.progress{height:6px;background:var(--surface-2);border-radius:3px;overflow:hidden;}
.progress-bar{height:100%;background:var(--ok);border-radius:3px;}
@media (max-width:640px){.unit-stats{grid-template-columns:repeat(2,1fr);}}

section{padding:clamp(56px,8vw,92px) 0;border-top:1px solid var(--line-soft);}
.sec-head{max-width:60ch;margin-bottom:44px;}
.sec-head .kicker{font-size:12.5px;font-weight:600;color:var(--amber);letter-spacing:.03em;margin:0 0 12px;}
h2{font-size:clamp(24px,3vw,34px);line-height:1.3;font-weight:700;letter-spacing:-.02em;margin:0 0 14px;color:var(--ink);}
.sec-head p{color:var(--ink-dim);font-size:16px;margin:0;line-height:1.75;}

.problems{display:grid;gap:0;border-top:1px solid var(--line);}
.prob{display:grid;grid-template-columns:minmax(0,7rem) minmax(0,1fr);gap:8px 32px;padding:26px 0;border-bottom:1px solid var(--line-soft);align-items:start;}
.prob .tag{font-size:13px;font-weight:600;color:var(--ink-mute);padding-top:3px;}
.prob h3{margin:0 0 7px;font-size:18.5px;font-weight:600;letter-spacing:-.01em;color:var(--ink);}
.prob p{margin:0;color:var(--ink-dim);font-size:15px;line-height:1.7;max-width:58ch;}
.prob .cost{margin-top:10px;font-size:13px;font-weight:600;color:var(--amber);background:var(--amber-wash);border:1px solid var(--amber-dim);display:inline-block;padding:3px 10px;border-radius:2px;}

.split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px;align-items:center;}
.flow{display:grid;gap:2px;}
.step{display:grid;grid-template-columns:30px minmax(0,1fr) auto;gap:16px;align-items:center;background:var(--surface);border:1px solid var(--line);padding:13px 16px;border-radius:2px;}
.step.hot{background:linear-gradient(90deg,var(--amber-wash),var(--surface) 60%);border-color:var(--amber-dim);}
.step .n{font-size:12.5px;font-weight:500;color:var(--ink-mute);}
.step .t{font-size:14.5px;color:var(--ink-dim);}
.step.hot .t{font-weight:600;color:var(--ink);}
.step .m{font-size:13px;color:var(--ink-mute);white-space:nowrap;}
.step.hot .m{color:var(--amber);font-weight:600;}
.flow-foot{margin-top:20px;font-size:14px;color:var(--ink-mute);line-height:1.7;}

.device-fig{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:clamp(20px,3vw,32px);}
.device-fig svg{width:130px;height:auto;display:block;margin:0 auto;}
.device-dim{text-align:center;font-size:11.5px;color:var(--ink-mute);margin:10px 0 20px;}
.spec-tbl{border-top:1px solid var(--line-soft);}
.spec-row{display:flex;justify-content:space-between;gap:16px;padding:9px 0;border-bottom:1px solid var(--line-soft);font-size:13px;}
.spec-row .k{color:var(--ink-mute);}
.spec-row .v{color:var(--ink);}
.device-cap{display:flex;justify-content:space-between;gap:16px;margin-top:18px;padding-top:16px;border-top:1px solid var(--line-soft);font-size:13px;color:var(--ink-mute);flex-wrap:wrap;}
.device-cap b{color:var(--ink-dim);font-weight:500;}

.feats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:4px;overflow:hidden;}
.feat{background:var(--surface);padding:28px 24px;transition:background .18s;}
.feat:hover{background:var(--surface-2);}
.feat .ic{width:34px;height:34px;margin-bottom:18px;border:1px solid var(--line);border-radius:6px;display:flex;align-items:center;justify-content:center;color:var(--amber);}
.feat .ic svg{width:18px;height:18px;display:block;}
.feat h3{margin:0 0 9px;font-size:17.5px;font-weight:600;letter-spacing:-.01em;color:var(--ink);}
.feat p{margin:0;color:var(--ink-dim);font-size:14.5px;line-height:1.72;}

.dash-fig{background:var(--surface);border:1px solid var(--line);border-radius:4px;overflow:hidden;margin-top:48px;}
.dash-top{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line);font-size:12.5px;color:var(--ink-mute);}
.dash-body{display:grid;grid-template-columns:220px minmax(0,1fr);}
.dash-nav{border-right:1px solid var(--line);padding:16px 0;}
.dash-nav a{display:flex;align-items:center;gap:10px;padding:9px 16px;font-size:13.5px;color:var(--ink-mute);text-decoration:none;border-left:2px solid transparent;}
.dash-nav a.active{color:var(--ink);border-left-color:var(--amber);background:var(--amber-wash);}
.dash-main{padding:20px;}
.dash-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:16px;}
.dash-card{background:var(--surface-2);border:1px solid var(--line);border-radius:3px;padding:12px 14px;}
.dash-card .l{font-size:11.5px;color:var(--ink-mute);margin-bottom:6px;}
.dash-card .v{font-size:19px;font-weight:600;color:var(--ink);font-variant-numeric:tabular-nums;}
.dash-card .v.warn{color:var(--danger);}
.dash-row-h{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-mute);padding:0 12px 6px;}
.dash-tbl{border:1px solid var(--line);border-radius:3px;overflow:hidden;}
.dtr{display:grid;grid-template-columns:80px minmax(0,1fr) 90px 70px;gap:10px;padding:9px 12px;font-size:13px;border-top:1px solid var(--line-soft);align-items:center;}
.dtr:first-child{border-top:none;}
.dtr .id{color:var(--ink);font-weight:500;}
.dtr .loc{color:var(--ink-dim);}
.dtr .st{font-size:11.5px;padding:2px 7px;border-radius:2px;width:fit-content;}
.dtr .st.on{background:rgba(79,174,133,.14);color:var(--ok);}
.dtr .st.idle{background:rgba(110,122,131,.16);color:var(--ink-mute);}
.dtr .st.alert{background:rgba(217,99,74,.16);color:var(--danger);}
.dtr .batt{color:var(--ink-mute);font-variant-numeric:tabular-nums;text-align:right;}

.local{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:4px;overflow:hidden;}
.local > div{background:var(--surface);padding:26px 22px;}
.local .num{font-size:12.5px;color:var(--amber);margin-bottom:12px;}
.local h3{margin:0 0 9px;font-size:16.5px;font-weight:600;color:var(--ink);}
.local p{margin:0;font-size:14.5px;color:var(--ink-dim);line-height:1.7;}

.cases{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:4px;overflow:hidden;}
.case{background:var(--surface);display:flex;flex-direction:column;}
.case .strip{height:3px;background:var(--amber);}
.case .body{padding:26px 24px 28px;display:flex;flex-direction:column;flex:1;}
.case .who{font-size:13px;color:var(--ink-mute);font-weight:500;margin-bottom:18px;}
.case .big{display:flex;align-items:baseline;gap:10px;margin-bottom:14px;}
.case .big b{font-size:42px;font-weight:700;letter-spacing:-.03em;line-height:1;color:var(--ink);}
.case .big span{font-size:14px;color:var(--ink-mute);}
.case h3{margin:0 0 8px;font-size:17px;font-weight:600;letter-spacing:-.01em;color:var(--ink);}
.case .delta{font-size:14px;color:var(--amber);font-variant-numeric:tabular-nums;margin:0 0 12px;padding-bottom:12px;border-bottom:1px solid var(--line-soft);}
.case p.d{margin:0;font-size:14px;color:var(--ink-dim);line-height:1.7;}

.price{background:var(--surface);border:1px solid var(--line);border-radius:4px;padding:clamp(24px,3vw,36px);max-width:680px;}
#price .sec-head{margin-left:auto;margin-right:auto;text-align:center;}
#price .price{margin-left:auto;margin-right:auto;text-align:left;}
.price-rows{display:grid;gap:0;margin:0 0 4px;}
.price-row{display:flex;align-items:baseline;gap:14px;padding:14px 0;border-bottom:1px solid var(--line-soft);flex-wrap:wrap;}
.price-row .lbl{font-size:15px;font-weight:500;color:var(--ink);}
.price-row .sub{font-size:13.5px;color:var(--ink-mute);}
.price-row .val{margin-left:auto;font-size:15.5px;font-weight:600;color:var(--ink-dim);font-variant-numeric:tabular-nums;white-space:nowrap;}
.price-total{display:flex;align-items:baseline;gap:14px;padding-top:18px;}
.price-total .lbl{font-size:15px;font-weight:600;color:var(--ink);}
.price-total .val{margin-left:auto;font-size:27px;font-weight:700;letter-spacing:-.02em;color:var(--amber);font-variant-numeric:tabular-nums;}
.price-note{margin:18px 0 0;font-size:13.5px;color:var(--ink-mute);line-height:1.7;}

.cta{background:var(--bg-1);}
.cta .wrap{text-align:center;}
.cta h2{max-width:18ch;margin-left:auto;margin-right:auto;}
.cta p{color:var(--ink-dim);font-size:16px;max-width:48ch;margin:0 auto 30px;line-height:1.75;}
.form{display:flex;gap:10px;flex-wrap:wrap;max-width:520px;margin:0 auto;justify-content:center;}
.cta-note{margin-top:16px;font-size:13px;color:var(--ink-mute);}
.form input{flex:1 1 240px;min-width:0;font-family:inherit;font-size:14.5px;padding:12px 16px;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:3px;}
.form input::placeholder{color:var(--ink-mute);}
.form input:focus{border-color:var(--amber);}

footer{background:var(--bg-1);border-top:1px solid var(--line-soft);padding:28px 0 40px;font-size:13px;color:var(--ink-mute);}
.foot-in{display:flex;gap:20px;flex-wrap:wrap;align-items:center;}
.foot-in .logo{color:var(--ink-dim);font-size:14px;}
.foot-links{display:flex;gap:18px;margin-left:auto;flex-wrap:wrap;}
.foot-links a{text-decoration:none;}
.foot-links a:hover{color:var(--ink);}

@media (max-width:860px){
  .split{grid-template-columns:1fr;gap:36px;}
  .dash-body{grid-template-columns:1fr;}
  .dash-nav{display:none;}
  .dash-grid{grid-template-columns:repeat(2,1fr);}
  .local{grid-template-columns:1fr;}
  .feats{grid-template-columns:repeat(2,1fr);}
  .cases{grid-template-columns:1fr;}
}
@media (max-width:640px){
  .nav-links a:not(.btn){display:none;}
  .stripe{grid-template-columns:repeat(2,1fr);}
  .stripe div:nth-child(3){border-left:none;}
  .prob{grid-template-columns:1fr;gap:6px;}
  .step{grid-template-columns:22px minmax(0,1fr);}
  .step .m{grid-column:2;padding-left:0;}
  .dtr{grid-template-columns:60px minmax(0,1fr) 70px;}
  .dtr .batt{display:none;}
  .feats{grid-template-columns:1fr;}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;}html{scroll-behavior:auto;}}
.pulse{transform-origin:center;animation:p 2.6s ease-out infinite;}
@keyframes p{0%{r:5;opacity:.55}70%{r:16;opacity:0}100%{r:16;opacity:0}}
/* apron live view — airside markings & GSE */
.tw-band{fill:none;stroke:#0E1419;stroke-width:26;stroke-linecap:round;}
.tw-cl{fill:none;stroke:#7B6526;stroke-width:1.4;stroke-dasharray:14 10;opacity:.85;}
.taxilane path{stroke:#6B5A2E;stroke-width:1;stroke-dasharray:5 5;opacity:.55;}
.leadin{fill:none;stroke:#5B4D26;stroke-width:.8;opacity:.35;}
.gpu-cable{stroke:#8FE3D8;stroke-width:.9;animation:cableBlink 1.6s ease-in-out infinite;}
@keyframes cableBlink{0%,100%{opacity:.35}50%{opacity:1}}
.hose{stroke:#F0A58F;stroke-width:1.1;stroke-dasharray:2 1.5;}
.belt-on .belt-run{animation:beltRun .5s linear infinite;}
@keyframes beltRun{to{stroke-dashoffset:-3.2}}
.ls-bldg rect{fill:#18212A;stroke:#2B3845;stroke-width:1}
.ls-stripe line{stroke:#223040;stroke-width:3}
.sel-ring{fill:none;stroke:#FFD166;stroke-width:1.6;animation:selPulse 1.2s ease-in-out infinite}
@keyframes selPulse{0%,100%{stroke-opacity:1}50%{stroke-opacity:.35}}
.ls-road{fill:none;stroke:#1B232B;stroke-linecap:round;stroke-linejoin:round}
.ls-edge{fill:none;stroke:#2E3A45;stroke-width:.6}
.ls-lane{fill:none;stroke:#5B6670;stroke-width:.4;stroke-dasharray:2.4 2.4;opacity:.8}
.ls-rail{fill:none;stroke:#4A5563;stroke-width:.5}
.ls-tree{fill:#1D3A27;stroke:#2B5236;stroke-width:.4}
.ls-b{fill:#26323D;stroke:#4C5F6D;stroke-width:.8}
.ls-plazaW{fill:#3A4652;stroke:#5D6F7C}
.ls-solar{fill:#1B3246;stroke:#2F4E68;stroke-width:.5}
.ls-ramp{fill:#1F2932;stroke:#4C5F6D;stroke-width:.8}
.ls-stripe line{stroke:#1D3448;stroke-width:3.2}
.ls .ls-road{fill:none;stroke:#1D2630;stroke-linecap:round;stroke-linejoin:round}
.ls .ls-park{fill:#122019;stroke:none}
.ls .ls-lot{fill:#16202A;stroke:#2A3744;stroke-width:.8}
.ls .ls-b{fill:#25313C;stroke:#43566A;stroke-width:.8}
.ls .ls-g{fill:#1F2A34;stroke:#43566A;stroke-width:.8}
.ls .ls-lbl{font-family:"IBM Plex Mono",monospace;fill:#5E7383;text-anchor:middle;font-weight:500;letter-spacing:.04em}
.ls .ls-shadow{fill:#070A0D;opacity:.6}
.ls .ls-roof{fill:#2B3844;stroke:#5A6F80;stroke-width:.9}
.ls .ls-parapet{fill:none;stroke:#3F5162;stroke-width:.7}
.ls .ls-bay{stroke:#3A4A58;stroke-width:.5}
.ls .ls-pv{fill:#1C3A55;stroke:#2E5578;stroke-width:.3}
